# ============================================================================
# LunaCore - dual-runner environment (Claude native + GLM)
# ----------------------------------------------------------------------------
# Copy to `.env.luna` and fill in the key. `.env.luna` is gitignored - the
# example is the committed contract, the real file never leaves the machine.
#
# This file configures ONLY the GLM runner. The native runner deliberately has
# no settings here: it uses whatever `claude` already uses (OAuth credentials
# in ~/.claude/.credentials.json), and scripts/claude-native.* actively CLEARS
# every variable below so a shell that sourced the GLM profile cannot leak
# into a native session.
#
# Nothing here touches ~/.claude - plugins, skills, agents, hooks and MCP
# servers stay shared between both runners. See setup.md.
# ============================================================================

# --- Provider preset ---------------------------------------------------------
# zai        - Z.ai's own Anthropic-compatible endpoint (default, first-party)
# openrouter - OpenRouter's Anthropic Skin (same protocol, different slugs)
# custom     - anything else that speaks the Anthropic Messages API; then you
#              MUST set LUNA_GLM_BASE_URL and LUNA_GLM_MODEL yourself.
LUNA_GLM_PROVIDER=zai

# --- Credential --------------------------------------------------------------
# Sent as a Bearer token (ANTHROPIC_AUTH_TOKEN). Never commit a real value.
LUNA_GLM_API_KEY=

# --- Endpoint and models -----------------------------------------------------
# Leave blank to take the preset defaults:
#   zai        -> https://api.z.ai/api/anthropic   glm-5.3 / glm-5.3-flash
#   openrouter -> https://openrouter.ai/api        z-ai/glm-5.3 / z-ai/glm-5.3-flash
# Set them to pin a different variant or point at your own proxy.
LUNA_GLM_BASE_URL=
LUNA_GLM_MODEL=
LUNA_GLM_FAST_MODEL=

# --- Timeouts ----------------------------------------------------------------
# GLM through a proxy is slower to first token than first-party Anthropic, and
# the default request timeout is what usually bites first on long agentic
# turns. Z.ai's own docs recommend a very generous value; 3000000 ms = 50 min.
LUNA_GLM_API_TIMEOUT_MS=3000000
# MCP server startup / per-tool-call ceilings (ms). Shared servers, but a
# slower model means longer gaps between calls, so npx-launched servers get
# more room here than the CLI default.
LUNA_GLM_MCP_TIMEOUT_MS=60000
LUNA_GLM_MCP_TOOL_TIMEOUT_MS=120000

# --- Telemetry ---------------------------------------------------------------
# 1 = suppress non-essential traffic back to Anthropic (telemetry, error
# reporting, update pings) while the session is talking to a third party.
# Set to 0 if you would rather leave Claude Code's default behaviour alone.
LUNA_GLM_DISABLE_NONESSENTIAL_TRAFFIC=1
