# Dependencies
node_modules/

# Builds / artifacts
dist/
out/
build/

# Logs
*.log
npm-debug.log*

# System / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Per-machine state and overrides. A PATTERN, not a list - an enumerated
# version kept losing layouts.local.json and rates.local.json (C1/B4 added
# them and nobody appended them here), so a private override could end up
# in the repo. The convention is one rule:
# *.local.* in config/ never goes to git.
#   profiles (secrets/keys), projects, cheatsheets, prompts, themes, layouts,
#   rates, ui (theme/language/layout), scratchpad (private notes),
#   repos (which repos the git station watches)
config/*.local.json
config/*.local.md
# Luna Core Memory mirror (src/memorystore.js): what Luna learned, per user.
config/memory/
.env

# Luna's Work error tracking secrets (src/lunasworkErrorTracking.js): the DSN
# and the importer token, wherever the store file lands. Never in git.
**/error-tracking.local.json
**/error-tracking.local.json.tmp

# Dual-runner secrets (GLM key). The committed contract is
# .env.luna.example - the filled-in copy never goes to git.
.env.luna

# Written at runtime by locallaunch.js (lean-MCP LM Studio tabs), per machine.
config/lmstudio-empty-mcp.json

# God Mode worker briefs (src/orchestra.js), written per launch.
config/tasks/

# Runtime output: God Mode run snapshot and weekly HTML reports, per machine.
config/runs/
config/weekly/

# Python bytecode (helpers/agent-reach, the vendored News fetcher).
__pycache__/

# Playwright MCP screenshots / logs
.playwright-mcp/

# Luna Host.command: package-lock.json hash of the last npm ci
.host-lock.sha256

# Passkeys paired on this host (src/hostpairing.js) and seen command nonces.
# Never in git, never read from the cloud.
host-keys.local.json
host-nonces.local.json

# Impeccable hook's per-session edit cache (absolute paths, edit counts).
# Machine-local; tracked, it made every God Mode package "touch" it and
# conflict on merge (src/orchestraIntegrate.js drops it from old branches).
.impeccable/hook.cache.json
