# Dependencies
node_modules/

# Builds / artifacts
dist/
out/
build/

# Logs
*.log
npm-debug.log*

# System / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Per-machine state and overrides. A PATTERN, not a list - an enumerated
# version kept losing layouts.local.json and rates.local.json (C1/B4 added
# them and nobody appended them here), so a private override could end up
# in the repo. The convention is one rule:
# *.local.* in config/ never goes to git.
#   profiles (secrets/keys), projects, cheatsheets, prompts, themes, layouts,
#   rates, ui (theme/language/layout), scratchpad (private notes)
config/*.local.json
config/*.local.md
.env
