{
  "providers": [
    {
      "id": "claude-cloud",
      "label": { "pl": "Claude Cloud", "en": "Claude Cloud" },
      "wireVia": "direct",
      "requiresApiKey": false,
      "envTemplate": {},
      "docsUrl": "https://claude.com/claude-code"
    },
    {
      "id": "lm-studio",
      "label": { "pl": "LM Studio (lokalnie)", "en": "LM Studio (local)" },
      "wireVia": "direct",
      "requiresApiKey": false,
      "autoModel": true,
      "envTemplate": {
        "ANTHROPIC_BASE_URL": "http://localhost:1234",
        "ANTHROPIC_AUTH_TOKEN": "lmstudio"
      },
      "localLaunch": { "shim": true, "leanMcp": true, "leanTools": true },
      "docsUrl": "https://lmstudio.ai/docs/developer/anthropic-compat/messages"
    },
    {
      "id": "glm",
      "label": { "pl": "GLM (Z.ai)", "en": "GLM (Z.ai)" },
      "wireVia": "direct",
      "requiresApiKey": true,
      "defaultModel": "glm-5.3",
      "defaultFastModel": "glm-5.3-flash",
      "envTemplate": {
        "ANTHROPIC_BASE_URL": "https://api.z.ai/api/anthropic",
        "ANTHROPIC_AUTH_TOKEN": "{{apiKey}}",
        "ANTHROPIC_MODEL": "{{model}}",
        "ANTHROPIC_DEFAULT_OPUS_MODEL": "{{model}}",
        "ANTHROPIC_DEFAULT_SONNET_MODEL": "{{model}}",
        "ANTHROPIC_DEFAULT_FABLE_MODEL": "{{model}}",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "{{fastModel}}",
        "ANTHROPIC_SMALL_FAST_MODEL": "{{fastModel}}",
        "CLAUDE_CODE_SUBAGENT_MODEL": "{{model}}",
        "API_TIMEOUT_MS": "3000000"
      },
      "docsUrl": "https://docs.z.ai"
    },
    {
      "id": "kimi",
      "label": { "pl": "Kimi (Moonshot)", "en": "Kimi (Moonshot)" },
      "wireVia": "direct",
      "requiresApiKey": true,
      "defaultModel": "kimi-k2-0905-preview",
      "envTemplate": {
        "ANTHROPIC_BASE_URL": "https://api.moonshot.ai/anthropic",
        "ANTHROPIC_AUTH_TOKEN": "{{apiKey}}",
        "ANTHROPIC_MODEL": "{{model}}"
      },
      "docsUrl": "https://platform.moonshot.ai/docs"
    },
    {
      "id": "kimi-code",
      "label": { "pl": "Kimi Code (subskrypcja)", "en": "Kimi Code (subscription)" },
      "wireVia": "direct",
      "requiresApiKey": true,
      "defaultModel": "k3-256k",
      "envTemplate": {
        "ANTHROPIC_BASE_URL": "https://api.kimi.ai/coding/",
        "ANTHROPIC_API_KEY": "{{apiKey}}",
        "ANTHROPIC_MODEL": "{{model}}",
        "ANTHROPIC_DEFAULT_OPUS_MODEL": "{{model}}",
        "ANTHROPIC_DEFAULT_SONNET_MODEL": "{{model}}",
        "ANTHROPIC_DEFAULT_FABLE_MODEL": "{{model}}",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "{{model}}",
        "ANTHROPIC_SMALL_FAST_MODEL": "{{model}}",
        "CLAUDE_CODE_SUBAGENT_MODEL": "{{model}}",
        "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "262144",
        "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "262144",
        "CLAUDE_CODE_EFFORT_LEVEL": "high"
      },
      "docsUrl": "https://www.kimi.com/code/docs/en/third-party-tools/claude-code.html"
    },
    {
      "id": "openrouter",
      "label": { "pl": "OpenRouter (darmowe modele)", "en": "OpenRouter (free models)" },
      "wireVia": "direct",
      "requiresApiKey": true,
      "defaultModel": "openrouter/free",
      "defaultFastModel": "openrouter/free",
      "envTemplate": {
        "ANTHROPIC_BASE_URL": "https://openrouter.ai/api",
        "ANTHROPIC_AUTH_TOKEN": "{{apiKey}}",
        "ANTHROPIC_MODEL": "{{model}}",
        "ANTHROPIC_DEFAULT_OPUS_MODEL": "{{model}}",
        "ANTHROPIC_DEFAULT_SONNET_MODEL": "{{model}}",
        "ANTHROPIC_DEFAULT_FABLE_MODEL": "{{model}}",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "{{fastModel}}",
        "ANTHROPIC_SMALL_FAST_MODEL": "{{fastModel}}",
        "CLAUDE_CODE_SUBAGENT_MODEL": "{{model}}"
      },
      "docsUrl": "https://openrouter.ai/docs/guides/guides/claude-code-integration"
    },
    {
      "id": "freellm-claude",
      "label": { "pl": "FreeLLMAPI (claude, darmowe modele)", "en": "FreeLLMAPI (claude, free models)" },
      "wireVia": "direct",
      "requiresApiKey": true,
      "defaultModel": "",
      "envTemplate": {
        "ANTHROPIC_BASE_URL": "http://127.0.0.1:31415",
        "ANTHROPIC_AUTH_TOKEN": "{{apiKey}}",
        "ANTHROPIC_MODEL": "{{model}}"
      },
      "docsUrl": "https://github.com/tashfeenahmed/freellmapi"
    },
    {
      "id": "freellm-chain",
      "label": { "pl": "FreeLLMAPI (claude, lancuch zapasowych modeli)", "en": "FreeLLMAPI (claude, fallback chain)" },
      "wireVia": "direct",
      "requiresApiKey": true,
      "defaultModel": "",
      "fallbackChain": "free-coding",
      "envTemplate": {
        "ANTHROPIC_BASE_URL": "http://127.0.0.1:31415",
        "ANTHROPIC_AUTH_TOKEN": "{{apiKey}}",
        "API_TIMEOUT_MS": "3000000"
      },
      "docsUrl": "https://github.com/tashfeenahmed/freellmapi"
    },
    {
      "id": "freellm-codex",
      "label": { "pl": "FreeLLMAPI (Codex CLI, darmowe modele)", "en": "FreeLLMAPI (Codex CLI, free models)" },
      "wireVia": "native",
      "command": "codex",
      "args": [
        "-c", "model_provider=freellmapi",
        "-c", "model_providers.freellmapi.name=FreeLLMAPI",
        "-c", "model_providers.freellmapi.base_url=http://127.0.0.1:31415/v1",
        "-c", "model_providers.freellmapi.env_key=FREELLM_API_KEY",
        "-c", "model_providers.freellmapi.wire_api=responses",
        "-m", "auto"
      ],
      "requiresApiKey": true,
      "envTemplate": {
        "FREELLM_API_KEY": "{{apiKey}}"
      },
      "docsUrl": "https://github.com/tashfeenahmed/freellmapi"
    },
    {
      "id": "freellm-gemini",
      "label": { "pl": "FreeLLMAPI (Gemini CLI, darmowe modele)", "en": "FreeLLMAPI (Gemini CLI, free models)" },
      "wireVia": "native",
      "command": "gemini",
      "gatewayHome": true,
      "requiresApiKey": true,
      "envTemplate": {
        "GOOGLE_GEMINI_BASE_URL": "http://127.0.0.1:31415",
        "GEMINI_API_KEY": "{{apiKey}}"
      },
      "docsUrl": "https://github.com/tashfeenahmed/freellmapi"
    },
    {
      "id": "codex-cli",
      "label": { "pl": "Codex CLI (konto ChatGPT)", "en": "Codex CLI (ChatGPT account)" },
      "wireVia": "native",
      "command": "codex",
      "requiresApiKey": false,
      "envTemplate": {},
      "docsUrl": "https://developers.openai.com/codex/cli"
    },
    {
      "id": "gemini-cli",
      "label": { "pl": "Gemini CLI (konto Google)", "en": "Gemini CLI (Google account)" },
      "wireVia": "native",
      "command": "gemini",
      "requiresApiKey": false,
      "optionalApiKey": true,
      "envTemplate": {
        "GEMINI_API_KEY": "{{apiKey}}"
      },
      "docsUrl": "https://geminicli.com/docs/resources/quota-and-pricing/"
    },
    {
      "id": "ollama",
      "label": { "pl": "Ollama (lokalnie, przez CCR)", "en": "Ollama (local, via CCR)" },
      "wireVia": "ccr",
      "requiresApiKey": true,
      "ccrProviderType": "ollama",
      "defaultModel": "",
      "defaultFastModel": "",
      "envTemplate": {
        "ANTHROPIC_BASE_URL": "http://localhost:{{ccrPort}}",
        "ANTHROPIC_AUTH_TOKEN": "{{apiKey}}",
        "ANTHROPIC_MODEL": "{{model}}",
        "ANTHROPIC_SMALL_FAST_MODEL": "{{fastModel}}"
      },
      "docsUrl": "https://ollama.com"
    },
    {
      "id": "codex",
      "label": { "pl": "Codex (OpenAI, przez CCR)", "en": "Codex (OpenAI, via CCR)" },
      "wireVia": "ccr",
      "requiresApiKey": true,
      "ccrProviderType": "openai",
      "defaultModel": "",
      "defaultFastModel": "",
      "envTemplate": {
        "ANTHROPIC_BASE_URL": "http://localhost:{{ccrPort}}",
        "ANTHROPIC_AUTH_TOKEN": "{{apiKey}}",
        "ANTHROPIC_MODEL": "{{model}}",
        "ANTHROPIC_SMALL_FAST_MODEL": "{{fastModel}}"
      },
      "docsUrl": "https://platform.openai.com/docs"
    },
    {
      "id": "gemini",
      "label": { "pl": "Gemini (przez CCR)", "en": "Gemini (via CCR)" },
      "wireVia": "ccr",
      "requiresApiKey": true,
      "ccrProviderType": "gemini",
      "defaultModel": "",
      "defaultFastModel": "",
      "envTemplate": {
        "ANTHROPIC_BASE_URL": "http://localhost:{{ccrPort}}",
        "ANTHROPIC_AUTH_TOKEN": "{{apiKey}}",
        "ANTHROPIC_MODEL": "{{model}}",
        "ANTHROPIC_SMALL_FAST_MODEL": "{{fastModel}}"
      },
      "docsUrl": "https://ai.google.dev/gemini-api/docs"
    },
    {
      "id": "grok",
      "label": { "pl": "Grok (xAI, przez CCR)", "en": "Grok (xAI, via CCR)" },
      "wireVia": "ccr",
      "requiresApiKey": true,
      "ccrProviderType": "openai-compatible",
      "defaultModel": "",
      "defaultFastModel": "",
      "envTemplate": {
        "ANTHROPIC_BASE_URL": "http://localhost:{{ccrPort}}",
        "ANTHROPIC_AUTH_TOKEN": "{{apiKey}}",
        "ANTHROPIC_MODEL": "{{model}}",
        "ANTHROPIC_SMALL_FAST_MODEL": "{{fastModel}}"
      },
      "docsUrl": "https://docs.x.ai"
    },
    {
      "id": "openai-compatible",
      "label": { "pl": "Wlasny (OpenAI-compatible, przez CCR)", "en": "Custom (OpenAI-compatible, via CCR)" },
      "wireVia": "ccr",
      "requiresApiKey": true,
      "ccrProviderType": "openai-compatible",
      "defaultModel": "",
      "defaultFastModel": "",
      "envTemplate": {
        "ANTHROPIC_BASE_URL": "http://localhost:{{ccrPort}}",
        "ANTHROPIC_AUTH_TOKEN": "{{apiKey}}",
        "ANTHROPIC_MODEL": "{{model}}",
        "ANTHROPIC_SMALL_FAST_MODEL": "{{fastModel}}"
      },
      "docsUrl": ""
    }
  ]
}
